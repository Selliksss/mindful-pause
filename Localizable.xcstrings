        }
      }
    },
    "Look out the window for 30 seconds. Shift attention outward." : {
      "comment" : "Text displayed in a tip view when the user has completed 75% of the break.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ru" : {
          "stringUnit" : {
